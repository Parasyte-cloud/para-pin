{
  "name": "para-pin",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "Registry" },
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "USER_CHANNEL", "class_name": "UserChannel" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Registry", "ChatRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["UserChannel"] }
  ]
}
