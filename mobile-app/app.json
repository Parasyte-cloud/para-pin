{
  "expo": {
    "name": "PArA PIN",
    "slug": "para-pin-mobile",
    "scheme": "parapin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#050608",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "cloud.parasyte.parapin",
      "supportsTablet": false,
      "backgroundColor": "#050608",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for video calls and sending photos in chats.",
        "NSMicrophoneUsageDescription": "Used for audio and video calls.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock PArA PIN faster than typing your PIN."
      }
    },
    "android": {
      "package": "cloud.parasyte.parapin",
      "backgroundColor": "#050608",
      "adaptiveIcon": {
        "backgroundColor": "#050608",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "RECORD_AUDIO"],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#050608"
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050608"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
