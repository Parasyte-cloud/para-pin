# @config-plugins/react-native-webrtc's latest published version (15.0.1)
# still declares peerDependencies.expo "^56" -- it hasn't been republished
# for Expo SDK 57 yet (checked the npm registry directly: no 15.0.2/16.x
# exists as of this writing). The plugin itself just does static
# Info.plist/AndroidManifest edits via @expo/config-plugins, which is
# stable across this SDK bump, so the peer mismatch is a stale version
# range on the upstream package, not an actual incompatibility. Without
# this, `npm install`/`npm ci` fails outright under npm's default strict
# peer-dep resolution (ERESOLVE) -- this is exactly what broke both the
# local iOS build step and the remote EAS "Install dependencies" phase.
# Safe to remove once @config-plugins/react-native-webrtc publishes an
# SDK-57-compatible release.
legacy-peer-deps=true
